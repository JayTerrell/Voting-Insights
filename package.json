{
  "name": "votershub",
  "version": "1.0.0",
  "private": true,
  "description": "Nonpartisan Texas 2026 general election candidate guide and issue alignment quiz.",
  "type": "module",
  "main": "server/app.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:data": "node scripts/build-data.js",
    "predev": "node scripts/build.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "prestart": "node scripts/build.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "import:ballot": "node scripts/import-ballot.js",
    "research:status": "node scripts/research-status.js",
    "check:links": "node scripts/check-links.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "format:check": "prettier --check .",
    "db:check": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/db-check.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.1.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
