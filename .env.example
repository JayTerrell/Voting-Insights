# Copy to .env for local development, or set these in the Vercel project settings.

# Public base URL used in share links and emails.
PUBLIC_URL=http://localhost:3000

# Postgres connection string (required on Vercel). Leave empty locally to use SQLite.
# For Supabase, use the Transaction pooler connection string (port 6543). See docs/DEPLOYING.md.
DATABASE_URL=

# Your database provider's CA certificate (for Supabase: Project Settings, Database, SSL Configuration,
# Download certificate). Paste the whole file, including the BEGIN and END lines, inside double quotes.
DATABASE_CA_CERT=

# Local SQLite file, used only when DATABASE_URL is empty.
DATABASE_PATH=storage/voting-insights.db

# Outgoing email. Any SMTP provider works (Postmark, SendGrid, Amazon SES, Mailgun, Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Voting Insights <results@example.org>

# At least 24 random characters. Unlocks /api/admin/users.csv and /api/admin/results.csv.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Public contact for corrections and privacy requests, shown in the Terms and Privacy Policy.
CONTACT_EMAIL=
